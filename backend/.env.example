# backend/.env（本機開發）。所有相對路徑以 backend/ 為基準。
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=benefits
REDIS_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

DATA_DIR=../data
DEMO_SEED_PATH=../data/demo/seed_v2.json
DEMO_SEED_ON_STARTUP=true
CRAWL_ON_STARTUP=false

# 本地 AI（Ollama）：ollama | none
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# 資格骨幹（媒合分層）離線抽取用的模型；空白＝沿用 LLM_MODEL
CORE_LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=300
LLM_MAX_DOCUMENTS_PER_RUN=500
LLM_ASSIST_MATCHING=true

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
REQUEST_DELAY_SECONDS=1.0
RESPECT_ROBOTS_TXT=true
SSL_STRICT_X509=false
MAX_ITEMS_PER_SOURCE=300
INFER_JURISDICTION_FROM_PROVIDER=true

MATCH_HIGH_THRESHOLD=0.85
MATCH_POSSIBLE_THRESHOLD=0.5
REJECT_MIN_CONFIDENCE=0.8
LOG_LEVEL=INFO
