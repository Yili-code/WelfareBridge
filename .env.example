# 複製成 .env 後由 docker-compose（env_file）與 backend 讀取。
# 本機開發時可改用 backend/.env（見 backend/.env.example）。
# 注意：註解請獨立成行，不要寫在值後面（docker compose 會把行內註解當成值）。

# ---- 本地 AI（Ollama，安裝在主機；容器透過 host.docker.internal 連線）----
# ollama | none（none = 純規則式，AI 欄位維持空值並標記）
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=300
LLM_MAX_DOCUMENTS_PER_RUN=500
LLM_ASSIST_MATCHING=true

# ---- Crawler ----
CRAWL_INTERVAL_SECONDS=0
REQUEST_DELAY_SECONDS=1.0
HTTP_MAX_RETRIES=3
RESPECT_ROBOTS_TXT=true
MAX_ITEMS_PER_SOURCE=300
INFER_JURISDICTION_FROM_PROVIDER=true

# ---- App ----
LOG_LEVEL=INFO
MATCH_HIGH_THRESHOLD=0.85
MATCH_POSSIBLE_THRESHOLD=0.5
REJECT_MIN_CONFIDENCE=0.8
